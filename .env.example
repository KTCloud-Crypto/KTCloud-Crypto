# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=fastapi_db

# Backend database connection inside Docker Compose
DATABASE_URL=postgresql://postgres:CHANGE_ME_WITH_THE_SAME_PASSWORD@db:5432/fastapi_db

# Backend settings
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPBIT_API_BASE_URL=https://api.upbit.com
ENVIRONMENT=production
DEBUG=False
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=https://signaltrade.kro.kr
ALLOWED_HOSTS=signaltrade.kro.kr,api.signaltrade.kro.kr,localhost,127.0.0.1,backend

# Vite build-time API base URL (Nginx reverse proxy)
VITE_API_BASE_URL=/api

# HTTPS 인증서에 사용할 실제 도메인과 Let's Encrypt 알림 이메일
DOMAIN=signaltrade.kro.kr
CERTBOT_EMAIL=CHANGE_ME@example.com
HTTPS_ENABLED=false

# 거래소 API Key 암호화 키 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MASTER_ENCRYPTION_KEY=

# 텔레그램 알림 (선택, 미설정 시 알림 무시됨)
TELEGRAM_BOT_TOKEN=
