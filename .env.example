# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fastapi_db

# Backend database connection inside Docker Compose
DATABASE_URL=postgresql://postgres:password@db:5432/fastapi_db

# Backend settings
SECRET_KEY=your-secret-key
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_API_BASE_URL=https://api.upbit.com
ENVIRONMENT=development
DEBUG=True
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 거래소 API Key 암호화 키 (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MASTER_ENCRYPTION_KEY=

# 텔레그램 알림 (선택, 미설정 시 알림 무시됨)
TELEGRAM_BOT_TOKEN=
