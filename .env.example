# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=fastapi_db

# Backend database connection inside Docker Compose
DATABASE_URL=postgresql://postgres:CHANGE_ME_WITH_THE_SAME_PASSWORD@db:5432/fastapi_db

# Backend settings
SECRET_KEY=your-secret-key
UPBIT_API_BASE_URL=https://api.upbit.com
UPBIT_WS_URL=wss://api.upbit.com/websocket/v1
WATCH_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-TRX
STRATEGY_REFRESH_SECONDS=30
LIVE_TRADING_ENABLED=false
ENVIRONMENT=development

# 거래소 API Key 암호화 키
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=

# 텔레그램 알림 (선택, 미설정 시 알림 무시됨)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
POSITION_RECONCILIATION_SECONDS=60
STALE_EXECUTION_SECONDS=120

# Local MSA infrastructure
# LocalStack emulates AWS SQS locally. Production uses the normal AWS endpoint
# by leaving SQS_ENDPOINT_URL empty or unset.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localstack:4566
SQS_TRADING_COMMAND_QUEUE_NAME=signaltrade-trading-commands
OUTBOX_POLL_SECONDS=1

# Redis stores only rebuildable cache/short-lived locks, never trade history.
REDIS_URL=redis://redis:6379/0

# Frontend가 호출할 FastAPI 주소
VITE_API_BASE_URL=/api
