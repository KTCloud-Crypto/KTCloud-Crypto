{
  "annotations":{"list":[]},"editable":true,"schemaVersion":41,"tags":["signaltrade","api"],
  "title":"SignalTrade API 트래픽","uid":"signaltrade-api-traffic","version":1,
  "time":{"from":"now-6h","to":"now"},"templating":{"list":[
    {"name":"route","label":"API 경로","type":"query","datasource":{"uid":"prometheus","type":"prometheus"},"query":{"query":"label_values(signaltrade_http_requests_total, route)","refId":"PrometheusVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".*","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"status","label":"응답 상태 코드","type":"query","datasource":{"uid":"prometheus","type":"prometheus"},"query":{"query":"label_values(signaltrade_http_requests_total, status)","refId":"PrometheusVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".*","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"request_id","label":"요청 ID","type":"textbox","query":".*","current":{"text":".*","value":".*"}},
    {"name":"user_id","label":"사용자 ID","type":"textbox","query":".*","current":{"text":".*","value":".*"}}
  ]},
  "panels":[
    {"type":"timeseries","title":"API별 초당 요청 수","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by (method, route) (rate(signaltrade_http_requests_total{route=~\"$route\",status=~\"$status\"}[5m]))","legendFormat":"{{method}} {{route}}"}],"gridPos":{"h":8,"w":12,"x":0,"y":0}},
    {"type":"bargauge","title":"최근 1시간 요청량 상위 API 10개","description":"현재 시점 기준 직전 1시간 동안 요청이 많았던 서비스 API 10개입니다. 상태 확인 및 비정상 탐색 경로는 제외합니다.","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"suffix:회","decimals":0,"min":0}},"options":{"orientation":"horizontal","displayMode":"gradient","showUnfilled":true,"valueMode":"color","namePlacement":"auto","valuePlacement":"auto","sizing":"auto","minVizHeight":16,"minVizWidth":8},"targets":[{"expr":"topk(10, sum by (method, route) (increase(signaltrade_http_requests_total{route=~\"$route\",route!~\"/[.]env|/metrics|/healthz\",status=~\"$status\"}[1h])))","legendFormat":"{{method}} {{route}}","instant":true,"range":false}],"gridPos":{"h":8,"w":12,"x":12,"y":0}},
    {"type":"timeseries","title":"API별 5xx 오류 비율","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}},"targets":[{"expr":"sum by (method, route) (rate(signaltrade_http_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) / clamp_min(sum by (method, route) (rate(signaltrade_http_requests_total{route=~\"$route\"}[5m])), 0.001)","legendFormat":"{{method}} {{route}}"}],"gridPos":{"h":8,"w":12,"x":0,"y":8}},
    {"type":"timeseries","title":"API별 p95 응답시간","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, method, route) (rate(signaltrade_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))","legendFormat":"{{method}} {{route}}"}],"gridPos":{"h":8,"w":12,"x":12,"y":8}},
    {"type":"timeseries","title":"응답 상태 코드별 초당 요청 수","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by (status) (rate(signaltrade_http_requests_total{route=~\"$route\",status=~\"$status\"}[5m]))","legendFormat":"상태 코드 {{status}}"}],"gridPos":{"h":7,"w":8,"x":0,"y":16}},
    {"type":"timeseries","title":"Backend 처리 중 요청 수","description":"현재 Backend API가 처리하고 있는 HTTP 요청 수입니다. Worker 내부 작업은 Worker 대시보드에서 확인합니다.","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","min":0,"decimals":0}},"targets":[{"expr":"signaltrade_http_requests_in_progress{job=\"backend\"}","legendFormat":"Backend API"}],"gridPos":{"h":7,"w":8,"x":8,"y":16}},
    {"type":"logs","title":"API 오류 로그","datasource":{"uid":"loki"},"targets":[{"expr":"{service=\"backend\",log_type=\"operation\"} | json | route=~\"$route\" | status_code=~\"$status\" | status_code >= 500 | request_id=~\"$request_id\" | user_id=~\"$user_id\""}],"gridPos":{"h":7,"w":8,"x":16,"y":16}}
  ]
}
