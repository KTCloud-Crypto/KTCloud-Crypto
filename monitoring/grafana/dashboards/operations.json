{
  "annotations":{"list":[]},
  "editable":true,
  "schemaVersion":41,
  "tags":["signaltrade","operations","logs","hardware"],
  "title":"SignalTrade 운영 모니터링",
  "uid":"signaltrade-operations",
  "version":1,
  "refresh":"15s",
  "time":{"from":"now-6h","to":"now"},
  "templating":{"list":[
    {"name":"environment","label":"실행 환경","type":"query","datasource":{"uid":"loki","type":"loki"},"query":{"query":"label_values(environment)","refId":"LokiVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".+","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"service","label":"서비스","type":"query","datasource":{"uid":"loki","type":"loki"},"query":{"query":"label_values(service)","refId":"LokiVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".+","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"level","label":"로그 레벨","type":"query","datasource":{"uid":"loki","type":"loki"},"query":{"query":"label_values(level)","refId":"LokiVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".+","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"route","label":"API 경로","type":"query","datasource":{"uid":"prometheus","type":"prometheus"},"query":{"query":"label_values(signaltrade_http_requests_total, route)","refId":"PrometheusVariableQueryEditor-VariableQuery"},"includeAll":true,"allValue":".*","current":{"text":"전체","value":"$__all"},"refresh":1},
    {"name":"request_id","label":"요청 ID","type":"textbox","query":".*","current":{"text":".*","value":".*"}},
    {"name":"user_id","label":"사용자 ID","type":"textbox","query":".*","current":{"text":".*","value":".*"}}
  ]},
  "panels":[
    {"type":"stat","title":"백엔드 상태","datasource":{"uid":"prometheus"},"targets":[{"expr":"up{job=\"backend\"}"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"중단","color":"red"},"1":{"text":"정상","color":"green"}}}],"color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":0,"y":0}},
    {"type":"stat","title":"전략 Worker 상태","datasource":{"uid":"prometheus"},"targets":[{"expr":"up{job=\"strategy-worker\"}"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"중단","color":"red"},"1":{"text":"정상","color":"green"}}}],"color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":4,"y":0}},
    {"type":"stat","title":"PostgreSQL 상태","datasource":{"uid":"prometheus"},"targets":[{"expr":"pg_up"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"중단","color":"red"},"1":{"text":"정상","color":"green"}}}],"color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":8,"y":0}},
    {"type":"stat","title":"Upbit 실시간 연결","datasource":{"uid":"prometheus"},"targets":[{"expr":"max(signaltrade_websocket_connected{provider=\"upbit\"})"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"연결 끊김","color":"red"},"1":{"text":"연결됨","color":"green"}}}],"color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":12,"y":0}},
    {"type":"stat","title":"최근 1시간 로그 유실","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum(increase(loki_write_dropped_entries_total[1h]))"}],"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":16,"y":0}},
    {"type":"stat","title":"마지막 시세 수신 경과","datasource":{"uid":"prometheus"},"targets":[{"expr":"time() - max(signaltrade_market_stream_last_tick_timestamp_seconds)"}],"fieldConfig":{"defaults":{"unit":"s","color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":30},{"color":"red","value":60}]}}},"options":{"colorMode":"background","graphMode":"none"},"gridPos":{"h":4,"w":4,"x":20,"y":0}},

    {"type":"timeseries","title":"API 초당 요청 수","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by (status) (rate(signaltrade_http_requests_total{route=~\"$route\"}[5m]))","legendFormat":"상태 코드 {{status}}"}],"gridPos":{"h":8,"w":8,"x":0,"y":4}},
    {"type":"timeseries","title":"API 5xx 오류 비율","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}},"targets":[{"expr":"sum(rate(signaltrade_http_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(signaltrade_http_requests_total{route=~\"$route\"}[5m])), 0.001)","legendFormat":"5xx 오류 비율"}],"gridPos":{"h":8,"w":8,"x":8,"y":4}},
    {"type":"timeseries","title":"API p95 응답시간","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, route) (rate(signaltrade_http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))","legendFormat":"{{route}}"}],"gridPos":{"h":8,"w":8,"x":16,"y":4}},

    {"type":"timeseries","title":"Nginx 4xx·5xx 발생량 (5분)","datasource":{"uid":"loki"},"targets":[{"expr":"sum by (status_code) (count_over_time({service=\"frontend\",log_type=\"access\",environment=~\"$environment\"} | json [5m]))","legendFormat":"상태 코드 {{status_code}}"}],"gridPos":{"h":8,"w":8,"x":0,"y":12}},
    {"type":"timeseries","title":"서비스·레벨별 로그량 (5분)","datasource":{"uid":"loki"},"targets":[{"expr":"sum by (service, level) (count_over_time({service=~\"$service\",environment=~\"$environment\",level=~\"$level\"}[5m]))","legendFormat":"{{service}} {{level}}"}],"gridPos":{"h":8,"w":8,"x":8,"y":12}},
    {"type":"timeseries","title":"보안 이벤트 발생량 (5분)","datasource":{"uid":"loki"},"targets":[{"expr":"sum by (event, outcome) (count_over_time({log_type=\"security\",environment=~\"$environment\"} | json [5m]))","legendFormat":"{{event}} {{outcome}}"}],"gridPos":{"h":8,"w":8,"x":16,"y":12}},

    {"type":"timeseries","title":"호스트 CPU 사용률","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}},"targets":[{"expr":"1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))","legendFormat":"CPU 사용률"}],"gridPos":{"h":7,"w":6,"x":0,"y":20}},
    {"type":"timeseries","title":"호스트 메모리 사용률","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}},"targets":[{"expr":"1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes","legendFormat":"메모리 사용률"}],"gridPos":{"h":7,"w":6,"x":6,"y":20}},
    {"type":"timeseries","title":"호스트 시스템 부하","datasource":{"uid":"prometheus"},"targets":[{"expr":"node_load1","legendFormat":"1분 평균"},{"expr":"node_load5","legendFormat":"5분 평균"},{"expr":"node_load15","legendFormat":"15분 평균"}],"gridPos":{"h":7,"w":6,"x":12,"y":20}},
    {"type":"timeseries","title":"파일시스템 사용률","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}},"targets":[{"expr":"max by (mountpoint) (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})","legendFormat":"{{mountpoint}}"}],"gridPos":{"h":7,"w":6,"x":18,"y":20}},

    {"type":"timeseries","title":"컨테이너 CPU 사용량 상위 10개","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"cores"}},"targets":[{"expr":"topk(10, sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\"}[5m])))","legendFormat":"{{id}}"}],"gridPos":{"h":8,"w":12,"x":0,"y":27}},
    {"type":"timeseries","title":"컨테이너 메모리 사용량 상위 10개","datasource":{"uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"topk(10, sum by (id) (container_memory_working_set_bytes{id=~\"/docker/.+\"}))","legendFormat":"{{id}}"}],"gridPos":{"h":8,"w":12,"x":12,"y":27}},

    {"type":"timeseries","title":"Alloy → Loki 로그 전송 상태","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum(rate(loki_write_sent_entries_total[5m]))","legendFormat":"초당 전송"},{"expr":"sum(rate(loki_write_batch_retries_total[5m]))","legendFormat":"초당 재시도"},{"expr":"sum(rate(loki_write_dropped_entries_total[5m]))","legendFormat":"초당 유실"}],"gridPos":{"h":8,"w":12,"x":0,"y":35}},
    {"type":"timeseries","title":"Loki 로그 수신량","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum(rate(loki_distributor_lines_received_total[5m]))","legendFormat":"초당 로그 줄"},{"expr":"sum(rate(loki_distributor_bytes_received_total[5m]))","legendFormat":"초당 바이트"}],"gridPos":{"h":8,"w":12,"x":12,"y":35}},

    {"type":"logs","title":"애플리케이션 오류 로그","datasource":{"uid":"loki"},"targets":[{"expr":"{service=~\"$service\",environment=~\"$environment\",level=~\"ERROR|CRITICAL\"} | json | request_id=~\"$request_id\" | user_id=~\"$user_id\""}],"options":{"showTime":true,"wrapLogMessage":true,"enableLogDetails":true},"gridPos":{"h":10,"w":8,"x":0,"y":43}},
    {"type":"logs","title":"Nginx 4xx·5xx 로그","datasource":{"uid":"loki"},"targets":[{"expr":"{service=\"frontend\",log_type=\"access\",environment=~\"$environment\"} | json | request_id=~\"$request_id\""}],"options":{"showTime":true,"wrapLogMessage":true,"enableLogDetails":true},"gridPos":{"h":10,"w":8,"x":8,"y":43}},
    {"type":"logs","title":"보안 감사 로그","datasource":{"uid":"loki"},"targets":[{"expr":"{log_type=\"security\",environment=~\"$environment\"} | json | request_id=~\"$request_id\" | actor_user_id=~\"$user_id\""}],"options":{"showTime":true,"wrapLogMessage":true,"enableLogDetails":true},"gridPos":{"h":10,"w":8,"x":16,"y":43}}
  ]
}
