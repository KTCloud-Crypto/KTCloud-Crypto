discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "application_logs" {
  targets = discovery.docker.containers.targets

  // Do not feed the monitoring stack's own logs back into Loki.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "ktcloud-crypto"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.application_logs.output
  forward_to = [loki.process.json_logs.receiver]
}

loki.process "json_logs" {
  stage.json {
    expressions = {
      level       = "level",
      log_type    = "log_type",
      service     = "service",
      environment = "environment",
    }
  }
  stage.labels {
    values = {
      level       = "",
      log_type    = "",
      service     = "",
      environment = "",
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
